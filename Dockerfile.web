FROM python:3.15-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    QT_QPA_PLATFORM=offscreen \
    HJKSELL_ENV=production \
    HJKSELL_DATA_DIR=/data \
    PORT=8765

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libdbus-1-3 \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libxkbcommon0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-web.txt ./requirements-web.txt
RUN python -m pip install --no-cache-dir --requirement requirements-web.txt

COPY alembic ./alembic
COPY assets/fonts ./assets/fonts
COPY hjksell ./hjksell
COPY --chmod=755 deploy/web-entrypoint.sh /usr/local/bin/hjksell-web-entrypoint

RUN groupadd --gid 10001 hjksell \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin hjksell \
    && mkdir -p /data \
    && chown 10001:10001 /data

USER 10001:10001
EXPOSE 8765
ENTRYPOINT ["/usr/local/bin/hjksell-web-entrypoint"]
